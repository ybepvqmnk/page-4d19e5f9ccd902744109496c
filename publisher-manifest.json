nsform:uppercase;color:var(--ink-3);border-bottom:1px solid var(--ink-3);padding-bottom:6px;margin-bottom:14px}\n.qa{padding:14px 0;border-bottom:1px dotted var(--ink-3)}\n.qa:last-child{border-bottom:0}\n.qa .q{font-weight:700;font-size:15.5px;margin-bottom:6px}\n.qa .q::before{content:\"Q \";color:var(--amber);font-family:ui-monospace,Menlo,Consolas,monospace}\n.qa .a{color:var(--ink-2);font-size:15px}\n.qa .a::before{content:\"A \";color:var(--ink-3);font-family:ui-monospace,Menlo,Consolas,monospace}\n\n/* footer */\nfooter{padding:40px 0 60px;background:var(--ink);color:var(--paper-2)}\nfooter .wrap{display:grid;grid-template-columns:2fr 1fr 1fr;gap:24px}\nfooter h4{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--amber);margin:0 0 10px}\nfooter p{font-size:13px;color:var(--paper-2);margin:0 0 8px}\nfooter a{color:var(--paper)}\n@media(max-width:760px){footer .wrap{grid-template-columns:1fr}}\n\n@media(max-width:760px){\n  .hero-grid > *{grid-column:span 12 !important}\n  .doc .col4,.doc .col6,.doc .col8{grid-column:span 12}\n}\n</style><nav class=\"nav\" aria-label=\"主导航\">\n  <div class=\"nav-inner\">\n    <div class=\"brand-mark\">斗罗云 <span>douluos</span></div>\n    <div class=\"nav-links\">\n      <a href=\"#overview\">服务概述</a>\n      <a href=\"#plans\">套餐与价格</a>\n      <a href=\"#usage\">使用说明</a>\n      <a href=\"#faq\">常见问题</a>\n    </div>\n  </div>\n</nav>\n\n<main>\n\n<header class=\"hero\">\n  <div class=\"wrap\">\n    <div class=\"hero-meta\">\n      <span>斗罗云 douluos · 服务说明文档</span>\n      <span>编号 7602 · 按月与按年订阅</span>\n    </div>\n    <div class=\"hero-grid\">\n      <div class=\"h-col-3\">\n        <div class=\"kicker\">栏目 / 引言</div>\n        <p class=\"pull\">\"代理服务不是魔法，而是可被复核的线路、流量与配额。本页列明订阅前应知事项。\"</p>\n      </div>\n      <div class=\"h-col-6\">\n        <h1>斗罗云(douluos) · 斗罗云 douluos，<br>一份关于<em>配额</em>、<em>线路</em>与<em>设备</em>的说明书。</h1>\n        <p class=\"lede\">斗罗云以分级流量套餐、多设备同时在线与 IPLC 专线优化为核心结构。订阅者按套餐获得对应流量、设备数与节点池权限，支持按月或按年续订。本页不使用营销话术，仅说明服务边界与使用方式。</p>\n      </div>\n      <div class=\"h-col-3\">\n        <div class=\"spec\">\n          <div><span>套餐层级</span><b>三级</b></div>\n          <div><span>最低起付</span><b>¥15/月</b></div>\n          <div><span>设备上限</span><b>3 / 5 / 20</b></div>\n          <div><span>计费方式</span><b>按月 · 按年</b></div>\n          <div><span>支持</span><b>工单</b></div>\n        </div>\n      </div>\n    </div>\n    <div class=\"hero-foot\">\n      <small>阅读顺序：概述 → 套餐 → 使用说明 → 常见问题。</small>\n      <a class=\"btn btn-amber\" href=\"#plans\">查看套餐</a>\n    </div>\n  </div>\n</header>\n\n<section id=\"overview\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <div>\n        <div class=\"sec-num\">01 / 服务概述</div>\n        <h2>什么是斗罗云 douluos</h2>\n      </div>\n      <p class=\"sec-sub\">以下为服务结构与边界说明，订阅前请确认配额、设备数与线路类型是否符合使用需要。</p>\n    </div>\n\n    <div class=\"doc\">\n      <article class=\"col4\">\n        <h3>流量配额</h3>\n        <p>每个套餐均以\"每月极速流量\"作为计量单位，基础版、旗舰版与团队版分别对应 100GB、300GB 与 1000GB。流量按自然月重置，未使用部分不结转至次月。</p>\n      </article>\n      <article class=\"col4\">\n        <h3>设备同时在线</h3>\n        <p>同一账号可同时在线的设备数量随套餐变化：基础版 3 台、旗舰版 5 台、团队版 20 台。超出上限的新连接将被拒绝，已在线设备不受影响。</p>\n      </article>\n      <article class=\"col4\">\n        <h3>线路与节点池</h3>\n        <p>基础版使用普通线路节点池；旗舰版含 IPLC 专线游戏加速优化与全节点原生流媒体解锁；团队版提供 VIP 高带宽节点与企业定制路由选项。</p>\n      </article>\n      <article class=\"col6\">\n        <h3>流媒体兼容</h3>\n        <p>基础版提供基础流媒体解锁，满足常规地区内容访问；旗舰版与团队版扩展至全节点原生流媒体解锁，适用于更高要求的内容访问场景。具体可用内容随上游策略变化，不另行承诺。</p>\n      </article>\n      <article class=\"col6\">\n        <h3>计费与续订</h3>\n        <p>套餐支持按月付费与按年付费。按年付费价格分别为基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年。订阅到期后服务自动停止，不自动扣费，需订阅者主动续订。</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n<section id=\"plans\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <div>\n        <div class=\"sec-num\">02 / 套餐与价格</div>\n        <h2>三级套餐，按配额递进</h2>\n      </div>\n      <p class=\"sec-sub\">以下价格与权益以本页展示为准。选择套餐时，请以\"流量是否足够\"与\"设备数是否覆盖\"作为主要判断依据。</p>\n    </div>\n\n    <div class=\"plans\">\n\n      <article class=\"plan\">\n        <div class=\"plan-step\">01</div>\n        <div>\n          <div class=\"plan-name\">Tier 01 · 入门</div>\n          <h3 class=\"plan-title\">基础版</h3>\n          <p>适用于轻量浏览与单设备使用场景。</p>\n        </div>\n        <ul class=\"plan-feat\">\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <div class=\"plan-price\">\n          <div class=\"now\">¥15<span>/月</span></div>\n          <span class=\"year\">按年付 ¥150/年</span>\n          <a class=\"btn\" href=\"#\">订阅基础版</a>\n        </div>\n      </article>\n\n      <article class=\"plan\">\n        <div class=\"plan-step\">02</div>\n        <div>\n          <div class=\"plan-flag\">推荐</div>\n          <div class=\"plan-name\">Tier 02 · 进阶</div>\n          <h3 class=\"plan-title\">旗舰版</h3>\n          <p>适用于多设备、流媒体与游戏加速场景。</p>\n        </div>\n        <ul class=\"plan-feat\">\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n        <div class=\"plan-price\">\n          <div class=\"now\">¥35<span>/月</span></div>\n          <span class=\"year\">按年付 ¥350/年</span>\n          <a class=\"btn btn-amber\" href=\"#\">订阅旗舰版</a>\n        </div>\n      </article>\n\n      <article class=\"plan\">\n        <div class=\"plan-step\">03</div>\n        <div>\n          <div class=\"plan-name\">Tier 03 · 团队</div>\n          <h3 class=\"plan-title\">团队版</h3>\n          <p>适用于多人共用、企业路由与高带宽需求。</p>\n        </div>\n        <ul class=\"plan-feat\">\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n        <div class=\"plan-price\">\n          <div class=\"now\">¥85<span>/月</span></div>\n          <span class=\"year\">按年付 ¥850/年</span>\n          <a class=\"btn\" href=\"#\">订阅团队版</a>\n        </div>\n      </article>\n\n    </div>\n  </div>\n</section>\n\n<section id=\"usage\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <div>\n        <div class=\"sec-num\">03 / 使用说明</div>\n        <h2>从订阅到连接的四步</h2>\n      </div>\n      <p class=\"sec-sub\">本节说明客户端获取、节点选择、连接建立与异常处理的标准流程，供首次订阅者参照。</p>\n    </div>\n\n    <div class=\"cards\">\n\n      <article class=\"card\">\n        <div class=\"k\">步骤 01 · 订阅与账号</div>\n        <h3>完成套餐订阅</h3>\n        <p>在套餐区域选择对应层级并完成支付。账号信息将通过订单渠道发送，请妥善保存登录凭据。同一账号在不同套餐间切换时，按新套餐的配额与设备数生效。</p>\n      </article>\n\n      <article class=\"card\">\n        <div class=\"k\">步骤 02 · 客户端获取</div>\n        <h3>准备代理客户端</h3>\n        <p>斗罗云不强制指定单一客户端，订阅者可使用兼容通用代理协议的第三方客户端导入订阅地址。请从客户端官方渠道获取软件，避免使用来源不明的修改版本。</p>\n        <ul>\n          <li>Windows / macOS：桌面端客户端</li>\n          <li>Android / iOS：移动端客户端</li>\n          <li>导入方式：复制订阅地址至客户端</li>\n        </ul>\n      </article>\n\n      <article class=\"card\">\n        <div class=\"k\">步骤 03 · 节点选择</div>\n        <h3>选择对应线路</h3>\n        <p>导入订阅后，客户端会拉取当前套餐可用的节点列表。基础版仅显示普通线路节点；旗舰版与团队版额外显示 IPLC 专线节点与 VIP 高带宽节点。请按用途选择，而非仅按延迟选择。</p>\n      </article>\n\n      <article class=\"card\">\n        <div class=\"k\">步骤 04 · 连接与验证</div>\n        <h3>建立连接</h3>\n        <p>点击连接后，客户端进入代理状态。可在客户端内查看实时流量与连接时长。若连接失败，先切换节点，再检查订阅是否过期或设备数是否已达上限。如仍异常，通过工单反馈。</p>\n      </article>\n\n    </div>\n  </div>\n</section>\n\n<section id=\"faq\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <div>\n        <div class=\"sec-num\">04 / 常见问题</div>\n        <h2>按主题分组的问题与答复</h2>\n      </div>\n      <p class=\"sec-sub\">以下问答按\"套餐与计费\"\"设备与使用\"\"线路与性能\"三组排列，便于按场景查阅。</p>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>主题 A · 套餐与计费</h3>\n\n      <div class=\"qa\">\n        <p class=\"q\">基础版、旗舰版与团队版的主要区别是什么？</p>\n        <p class=\"a\">主要区别在于每月流量配额、同时在线设备数与线路类型。基础版提供 100GB 流量与 3 台设备；旗舰版提供 300GB、5 台设备并含 IPLC 专线优化；团队版提供 1000GB、20 台设备并含 VIP 高带宽节点与企业定制路由。</p>\n      </div>\n\n      <div class=\"qa\">\n        <p class=\"q\">按月与按年付费的功能是否一致？</p>\n        <p class=\"a\">同一套餐下按月与按年付费的功能权益完全一致，区别仅在于计费周期与总价。按年付费分别为 ¥150/年、¥350/年、¥850/年，相对按月累计有所优惠。</p>\n      </div>\n\n      <div class=\"qa\">\n        <p class=\"q\">套餐之间是否可以随时切换？</p>\n        <p class=\"a\">可以切换。切换后按新套餐的流量配额与设备数生效，原有套餐未使用流量不结转。具体升配或降配的补差规则以订单页说明为准。</p>\n      </div>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>主题 B · 设备与使用</h3>\n\n      <div class=\"qa\">\n        <p class=\"q\">同一账号在超过设备上限后会发生什么？</p>\n        <p class=\"a\">当同时在线设备数达到套餐上限时，新设备的连接请求将被拒绝，已在线设备继续正常使用。如需增加同时在线数量，请升级至更高套餐。</p>\n      </div>\n\n      <div class=\"qa\">\n        <p class=\"q\">是否需要在每台设备上单独安装客户端？</p>\n        <p class=\"a\">是。每台需要代理的设备应各自安装兼容的客户端并导入订阅地址。同一账号可在不同设备上登录，但同时在线总数受套餐限制。</p>\n      </div>\n\n      <div class=\"qa\">\n        <p class=\"q\">订阅地址是否需要手动更新？</p>\n        <p class=\"a\">一般情况下客户端会自动拉取最新节点列表。若长期未更新或切换套餐后节点未刷新，可在客户端内手动更新订阅地址。</p>\n      </div>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>主题 C · 线路与性能</h3>\n\n      <div class=\"qa\">\n        <p class=\"q\">IPLC 专线与普通线路的区别是什么？</p>\n        <p class=\"a\">IPLC 专线为旗舰版及以上套餐提供的优化线路，适用于对延迟与稳定性要求较高的场景，如游戏加速。普通线路为基础版提供的节点池，满足常规浏览与基础流媒体需要。</p>\n      </div>\n\n      <div class=\"qa\">\n        <p class=\"q\">流媒体解锁是否保证所有内容可访问？</p>\n        <p class=\"a\">不保证。基础流媒体解锁与全节点原生流媒体解锁覆盖范围随上游策略与地区授权变化。斗罗云提供线路层面的访问条件，不对具体内容版权与可用性作出承诺。</p>\n      </div>\n\n      <div class=\"qa\">\n        <p class=\"q\">连接不稳定时应如何处理？</p>\n        <p class=\"a\">先切换至同套餐内的其他节点；若问题持续，检查客户端是否为最新版本、订阅是否过期、设备数是否超限。如仍异常，通过工单提交设备型号、客户端名称与异常时间，以便排查。</p>\n      </div>\n    </div>\n\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div>\n      <h4>斗罗云 douluos</h4>\n      <p>本页为服务说明与套餐展示页面，内容以本页展示为准。订阅前请确认套餐配额、设备数与线路类型符合使用需要。</p>\n    </div>\n    <div>\n      <h4>导航</h4>\n      <p><a href=\"#overview\">服务概述</a></p>\n      <p><a href=\"#plans\">套餐与价格</a></p>\n      <p><a href=\"#usage\">使用说明</a></p>\n      <p><a href=\"#faq\">常见问题</a></p>\n    </div>\n    <div>\n      <h4>支持</h4>\n      <p>基础版 · 工单</p>\n      <p>旗舰版 · 7x24 优先工单</p>\n      <p>团队版 · 专属客户经理</p>\n    </div>\n  </div>\n</footer>",
